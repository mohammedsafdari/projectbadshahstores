# Docker/dev transient
*.log

# The rollback markers deploy/deploy.sh writes on the server, only after a health
# check has passed: `.deploy-good` is the commit now running and `.deploy-previous`
# the one before it, so a rollback is `bash deploy/deploy.sh "$(cat .deploy-previous)"`
# (D95).
.deploy-good
.deploy-previous

# Coverage
htmlcov/
.coverage
coverage.xml

.freebuff/
celerybeat-schedule*
celerybeat.pid
tools/review-report.txt

# Built by the Tailwind CLI (D93): never committed, built on every deploy and in
# the dev compose service.
static/css/app.css

# Private business data: cost prices and any other file that must never be
# committed to this public repository (D85).
*.private.csv
private/
