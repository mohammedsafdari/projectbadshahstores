      "old": "            costed_revenue=costed_revenue,",
      "new": "            costed_revenue=revenue[own_brand],",
      "note": "the costed column shows all the revenue"
    },
    {
      "id": "45f1-07-unknown-line-is-costed",
      "file": "apps/reports/queries.py",
      "old": "        LineOwner(brand=UNKNOWN_GROUP, category=UNKNOWN_GROUP, own_brand=False, has_cost=False),",
      "new": "        LineOwner(brand=UNKNOWN_GROUP, category=UNKNOWN_GROUP, own_brand=False, has_cost=True),",
      "note": "a line with no order line counts as having a cost"
    },
    {
