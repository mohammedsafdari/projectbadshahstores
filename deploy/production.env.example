# The production environment file (D95).
#
# Copy this to .env in the repository root ON THE SERVER and fill it in:
#   cp deploy/production.env.example .env
#
# The name is production.env.example, not .env.production or .env.example,
# because .gitignore and .dockerignore both match ".env.*" and neither must ever
# be able to catch this file by accident.
#
# Nothing in this file is a real secret. Every value is empty, CHANGE_ME, a
# flag, a plain word or an example host, and a test enforces that.
#
# The container-side DATABASE_URL and REDIS_URL (the ones naming db and redis)
# are built in docker-compose.prod.yml and override the two below, so those two
# lines only serve a command run by hand on the host.

# ---------------------------------------------------------------------------
# Django
# ---------------------------------------------------------------------------
# Django's own secret key: generate a new one for the server, never reuse the
# development value.
SECRET_KEY=CHANGE_ME
# 0 in production: the debug pages must never reach a customer.
DEBUG=0
# The settings module. The container writes this value itself, so it is only a
# fallback for a command run by hand on the host.
DJANGO_SETTINGS_MODULE=badshahstore.settings.prod

# ---------------------------------------------------------------------------
# Database (PostgreSQL 16, in Compose on the same server)
# ---------------------------------------------------------------------------
# The database user, its password and the database name Compose creates.
POSTGRES_USER=CHANGE_ME
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=CHANGE_ME
# The database address Django reads; the container's own value replaces this one.
DATABASE_URL=

# ---------------------------------------------------------------------------
# Redis (Celery broker, Celery results and the cache)
# ---------------------------------------------------------------------------
# The Redis password Compose passes to the server and to every client.
REDIS_PASSWORD=CHANGE_ME
# The Redis address Django reads; the container's own value replaces this one.
REDIS_URL=
# How many Celery tasks the worker runs at once.
CELERY_WORKER_CONCURRENCY=2

# ---------------------------------------------------------------------------
# Hosts, proxy and cookies (nginx and Cloudflare in front)
# ---------------------------------------------------------------------------
# The shop's own host name: Django answers 400 to any other Host.
ALLOWED_HOSTS=shop.example.com
# The form origins Django accepts a POST from, with the scheme.
CSRF_TRUSTED_ORIGINS=https://shop.example.com
# The absolute address used in messages; blank leaves links relative.
SITE_BASE_URL=https://shop.example.com
# The header Cloudflare sends with the visitor's real address (D89).
CLIENT_IP_HEADER=HTTP_CF_CONNECTING_IP
# nginx terminates HTTPS, so Django reads the scheme from this header pair.
SECURE_PROXY_SSL_HEADER=HTTP_X_FORWARDED_PROTO,https
# Read only when the header pair above is set: trust nginx's Host.
USE_X_FORWARDED_HOST=1
# Redirect an HTTP request to HTTPS inside Django as well.
SECURE_SSL_REDIRECT=1
# HSTS in seconds: one hour at the start (D94), raised once the site is proven.
SECURE_HSTS_SECONDS=3600
# The two cookies are HTTPS-only in production.
SESSION_COOKIE_SECURE=1
CSRF_COOKIE_SECURE=1

# ---------------------------------------------------------------------------
# Media (Cloudflare R2; leave empty for the local media folder)
# ---------------------------------------------------------------------------
# The bucket that holds the product photos; empty keeps the local folder.
R2_BUCKET_NAME=
# The Cloudflare account id that owns the bucket.
R2_ACCOUNT_ID=
# The R2 access key id for this bucket (a secret: keep it only in .env).
R2_ACCESS_KEY_ID=
# The R2 secret access key that goes with it (a secret: keep it only in .env).
R2_SECRET_ACCESS_KEY=
# The bare host name the photos are served from.
R2_MEDIA_HOST=
# Extra Content-Security-Policy image hosts, comma-separated; not needed on R2.
CSP_EXTRA_IMG_SOURCES=
# Send the policy as Report-Only (reported, not enforced); 0 enforces it.
CSP_REPORT_ONLY=0

# ---------------------------------------------------------------------------
# Backups (a private R2 bucket, separate from the media one; D96)
# ---------------------------------------------------------------------------
# The bucket that holds the encrypted database dumps; never the media bucket.
R2_BACKUP_BUCKET=
# The backup token's access key id (a secret: keep it only in .env).
R2_BACKUP_ACCESS_KEY_ID=
# The backup token's secret access key (a secret: keep it only in .env).
R2_BACKUP_SECRET_ACCESS_KEY=
# The age PUBLIC key the backup script encrypts with (starts with age1). The
# private key never lives on the server, so it is not in this file (D96, D97).
AGE_RECIPIENT=
# optional healthchecks.io ping address; empty means no missed-backup alarm.
BACKUP_PING_URL=

# ---------------------------------------------------------------------------
# Sentry (error tracking; empty DSN means it never starts)
# ---------------------------------------------------------------------------
# The project DSN; the owner copies it from the Sentry project settings.
SENTRY_DSN=
# The environment the errors are filed under.
SENTRY_ENVIRONMENT=production
# A release name such as a short commit hash; empty means none is sent.
SENTRY_RELEASE=
# How many requests are traced, between 0 and 1; 0.1 is the default.
SENTRY_TRACES_SAMPLE_RATE=0.1

# ---------------------------------------------------------------------------
# Email (Brevo SMTP) and SMS (MSG91)
# ---------------------------------------------------------------------------
# The Django email backend; SMTP is the real one.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# The SMTP host Brevo gives the account.
EMAIL_HOST=smtp.example.com
# The SMTP port (587 is STARTTLS).
EMAIL_PORT=587
# The SMTP user name, and its password (a secret: keep it only in .env).
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# 1 means STARTTLS on the connection.
EMAIL_USE_TLS=1
# How many seconds one SMTP call may take.
EMAIL_TIMEOUT=10
# The From address on every order email.
DEFAULT_FROM_EMAIL=Badshah Stores <orders@shop.example.com>
# 0 keeps order emails off until the sending domain has SPF and DKIM.
ORDER_EMAIL_ENABLED=0
# The SMS backend class; MSG91 is the real one.
SMS_BACKEND=apps.notifications.sms.Msg91SmsBackend
# 0 keeps order SMS off until the DLT templates are registered.
ORDER_SMS_ENABLED=0
# The MSG91 auth key (a secret: keep it only in .env).
MSG91_AUTH_KEY=
# The ten template ids as one line, for example OTP=abc,ORDER_PLACED=def.
MSG91_TEMPLATE_IDS=
# How many seconds one MSG91 call may take.
MSG91_TIMEOUT_SECONDS=10

# ---------------------------------------------------------------------------
# Payments (Razorpay; the live account is activated at KYC time)
# ---------------------------------------------------------------------------
# The gateway name: empty turns online payments off, "razorpay" turns them on.
PAYMENT_PROVIDER=
# The fake gateway must never be allowed in production.
PAYMENT_ALLOW_FAKE_GATEWAY=0
# The methods the checkout may offer, copied from the gateway dashboard.
PAYMENT_ENABLED_METHODS=
# How long an unpaid online order keeps its stock after the reservation window.
PAYMENT_GRACE_MINUTES=30
# How many times one refund is sent before a person must look at it.
REFUND_MAX_ATTEMPTS=3
# A refund still unfinished after this many minutes is checked with the provider.
REFUND_STALE_MINUTES=30
# Only money captured before this age is reconciled, so a capture is never raced.
PAYMENT_RECONCILE_MIN_AGE_MINUTES=15
# The key id and secret Razorpay issues (both secrets: keep them only in .env).
RAZORPAY_KEY_ID=CHANGE_ME
RAZORPAY_KEY_SECRET=CHANGE_ME
# The webhook secret that proves an event came from Razorpay.
RAZORPAY_WEBHOOK_SECRET=CHANGE_ME

# ---------------------------------------------------------------------------
# The shop
# ---------------------------------------------------------------------------
# The FSSAI licence number printed on our own-brand products; blank shows none.
SHOP_FSSAI_LICENCE=
# Hindi stays off in production until the Hindi content slice is done (D92).
HINDI_ENABLED=0
