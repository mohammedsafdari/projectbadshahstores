# Badshah Store — environment variables
# Copy this file to .env and fill in real values locally.
# .env is in .gitignore and must never be committed.

# Settings module used by manage.py defaults, Docker Compose, and CI.
DJANGO_SETTINGS_MODULE=badshahstore.settings.dev
# Production: DJANGO_SETTINGS_MODULE=badshahstore.settings.prod

# Required in all environments.
SECRET_KEY=placeholder-change-in-prod

# Comma-separated list of allowed hostnames.
ALLOWED_HOSTS=localhost,127.0.0.1

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------
# Optional. Leave commented out to use the defaults from the settings files.
# An uncommented value here overrides the default, including in production
# (prod.py defaults: SECURE_SSL_REDIRECT=True, SECURE_HSTS_SECONDS=3600).

# Redirect HTTP to HTTPS.
# SECURE_SSL_REDIRECT=1

# HSTS max-age in seconds. Production starts at one hour and the owner raises
# it once the site is proven on the real server.
# SECURE_HSTS_SECONDS=3600

# Set only behind a reverse proxy that terminates HTTPS. Comma-separated: header name, value.
# SECURE_PROXY_SSL_HEADER=HTTP_X_FORWARDED_PROTO,https

# Only read when SECURE_PROXY_SSL_HEADER is set; default is True in that case.
# USE_X_FORWARDED_HOST=1

# ---------------------------------------------------------------------------
# Database (Postgres)
# ---------------------------------------------------------------------------
# docker-compose.yml builds DATABASE_URL for containers from POSTGRES_USER,
# POSTGRES_PASSWORD and POSTGRES_DB, using the service name "db" instead of
# 127.0.0.1. Host-run commands still read 127.0.0.1 from the value below.
POSTGRES_USER=CHANGE_ME
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=CHANGE_ME
DATABASE_URL=postgres://CHANGE_ME:CHANGE_ME@127.0.0.1:5432/badshahstore

# ---------------------------------------------------------------------------
# Redis / Celery broker
# ---------------------------------------------------------------------------
# docker-compose.yml builds REDIS_URL for containers using the service name
# "redis" and REDIS_PASSWORD. Host-run commands read 127.0.0.1 from below.
REDIS_PASSWORD=CHANGE_ME
REDIS_URL=redis://:CHANGE_ME@127.0.0.1:6379/0

# Comma-separated origins, with scheme.
# CSRF_TRUSTED_ORIGINS=https://example.com

# ---------------------------------------------------------------------------
# Celery
# ---------------------------------------------------------------------------
CELERY_WORKER_CONCURRENCY=2

# ---------------------------------------------------------------------------
# Payment gateway (test mode only until told otherwise)
# ---------------------------------------------------------------------------
# Empty PAYMENT_PROVIDER means the checkout offers no online payment. Use
# "fake" on a development machine and "razorpay" on the test-mode site.
PAYMENT_PROVIDER=
# The fake gateway is refused unless this is exactly 1; never set it in prod.
PAYMENT_ALLOW_FAKE_GATEWAY=0
# Comma-separated method names copied from the gateway dashboard, for example
# upi,card,netbanking. Never hard-code or guess which methods are free.
PAYMENT_ENABLED_METHODS=
# How long an unpaid online order keeps its stock after the reservation window.
PAYMENT_GRACE_MINUTES=30
# A refund is retried this many times before it is marked failed and needs a
# person; a provider 4xx fails it at once.
REFUND_MAX_ATTEMPTS=3
# A refund the provider has not finished after this many minutes is checked.
REFUND_STALE_MINUTES=30
# Only captured money older than this is reconciled, so an in-flight capture is
# never raced.
PAYMENT_RECONCILE_MIN_AGE_MINUTES=15
# Absolute site address used in messages, for example https://example.com.
SITE_BASE_URL=
# Razorpay test-mode credentials (the live keys are chosen at KYC time).
RAZORPAY_KEY_ID=CHANGE_ME
RAZORPAY_KEY_SECRET=CHANGE_ME
RAZORPAY_WEBHOOK_SECRET=CHANGE_ME

# ---------------------------------------------------------------------------
# Production media: Cloudflare R2 through the S3 API (Slice 53, D94)
# ---------------------------------------------------------------------------
# Leave the R2_* lines empty (or commented out) to keep the local media folder,
# which is what staging and a first run use. Filling R2_BUCKET_NAME switches the
# default storage to R2, and then the four variables below it must all be set.

# The bucket that holds the product photos, for example badshah-media.
# R2_BUCKET_NAME=
# The Cloudflare account id that owns the bucket; it builds the endpoint address.
# R2_ACCOUNT_ID=
# The R2 access key id for this bucket. A secret: never commit it.
# R2_ACCESS_KEY_ID=
# The R2 secret access key that goes with it. A secret: never commit it.
# R2_SECRET_ACCESS_KEY=
# The bare host name the photos are served from, for example media.example.com.
# prod.py adds that origin to the Content-Security-Policy itself.
# R2_MEDIA_HOST=

# Extra image hosts allowed by the Content-Security-Policy, comma-separated.
# Only needed for a picture that is not on the shop's own site or on R2.
# CSP_EXTRA_IMG_SOURCES=
# Send the Content-Security-Policy as Report-Only: a browser reports the
# violations but enforces nothing, which is how a new rule is tried first.
# CSP_REPORT_ONLY=0
# HSTS max-age in seconds. Production defaults to 3600 (one hour, D94).
# SECURE_HSTS_SECONDS=3600
