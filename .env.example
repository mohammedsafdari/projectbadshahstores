# Badshah Store — environment variables
# Copy this file to .env and fill in real values locally.
# .env is in .gitignore and must never be committed.

# Django settings module (used by manage.py defaults and Docker for dev)
DJANGO_SETTINGS_MODULE=badshahstore.settings.dev

# Security
SECRET_KEY=placeholder-change-in-prod
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (host-run commands use 127.0.0.1 / the values below)
# docker-compose.yml overrides DATABASE_URL and REDIS_URL with the service names
# (db, redis) for containers.
POSTGRES_USER=CHANGE_ME
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=CHANGE_ME
DATABASE_URL=postgres://CHANGE_ME:CHANGE_ME@127.0.0.1:5432/badshahstore

# Redis (Django/cache/Celery broker)
# docker-composeyml overrides REDIS_URL for containers.
REDIS_PASSWORD=CHANGE_ME
REDIS_URL=redis://:CHANGE_ME@127.0.0.1:6379/0

# Celery
CELERY_WORKER_CONCURRENCY=2

# Optional third-party providers (console backends used in dev until real credentials)
# EMAIL_BACKEND=console
# OTP/SMS/WhatsApp backend: console in dev

# Payment gateway (test mode only until told otherwise)
RAZORPAY_TEST_KEY_ID=CHANGE_ME
RAZORPAY_TEST_KEY_SECRET=CHANGE_ME

# Optional staging overrides
# DJANGO_SETTINGS_MODULE=badshahstore.settings.prod
