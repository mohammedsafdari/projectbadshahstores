# Badshah Store — environment variables
# Copy this file to .env and fill in real values locally.
# .env is in .gitignore and must never be committed.

# Settings module used by manage.py defaults, Docker Compose, and CI.
DJANGO_SETTINGS_MODULE=badshahstore.settings.dev
# Production: DJANGO_SETTINGS_MODULE=badshahstore.settings.prod

# Required in all environments.
SECRET_KEY=placeholder-change-in-prod

# Comma-separated list of allowed hostnames.
ALLOWED_HOSTS=localhost,127.0.0.1

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------
# Optional. Leave commented out to use the defaults from the settings files.
# An uncommented value here overrides the default, including in production
# (prod.py defaults: SECURE_SSL_REDIRECT=True, SECURE_HSTS_SECONDS=31536000).

# Redirect HTTP to HTTPS.
# SECURE_SSL_REDIRECT=1

# HSTS max-age in seconds.
# SECURE_HSTS_SECONDS=31536000

# Set only behind a reverse proxy that terminates HTTPS. Comma-separated: header name, value.
# SECURE_PROXY_SSL_HEADER=HTTP_X_FORWARDED_PROTO,https

# Only read when SECURE_PROXY_SSL_HEADER is set; default is True in that case.
# USE_X_FORWARDED_HOST=1

# ---------------------------------------------------------------------------
# Database (Postgres)
# ---------------------------------------------------------------------------
# docker-compose.yml builds DATABASE_URL for containers from POSTGRES_USER,
# POSTGRES_PASSWORD and POSTGRES_DB, using the service name "db" instead of
# 127.0.0.1. Host-run commands still read 127.0.0.1 from the value below.
POSTGRES_USER=CHANGE_ME
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=CHANGE_ME
DATABASE_URL=postgres://CHANGE_ME:CHANGE_ME@127.0.0.1:5432/badshahstore

# ---------------------------------------------------------------------------
# Redis / Celery broker
# ---------------------------------------------------------------------------
# docker-compose.yml builds REDIS_URL for containers using the service name
# "redis" and REDIS_PASSWORD. Host-run commands read 127.0.0.1 from below.
REDIS_PASSWORD=CHANGE_ME
REDIS_URL=redis://:CHANGE_ME@127.0.0.1:6379/0

# Comma-separated origins, with scheme.
# CSRF_TRUSTED_ORIGINS=https://example.com

# ---------------------------------------------------------------------------
# Celery
# ---------------------------------------------------------------------------
CELERY_WORKER_CONCURRENCY=2

# ---------------------------------------------------------------------------
# Payment gateway (test mode only until told otherwise)
# ---------------------------------------------------------------------------
RAZORPAY_TEST_KEY_ID=CHANGE_ME
RAZORPAY_TEST_KEY_SECRET=CHANGE_ME
